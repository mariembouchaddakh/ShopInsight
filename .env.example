# Modèle de configuration : copier en .env puis remplir. Ce fichier-ci peut être commité (aucun secret).
OPENROUTER_API_KEY=
# OM5: rédaction structurée via Groq (Gemini reste optionnel). Ne jamais committer les vraies clés.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OM5_LLM_PROVIDER=groq
OM5_LLM_ENABLED=false
# Fournisseur alternatif: OM5_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Budget strictement nul : modèles gratuits uniquement (suffixe :free, prix 0 vérifié en direct), aucun repli payant.
LLM_BUDGET_USD=0
LLM_FREE_ONLY=true
LLM_MODEL_A=nvidia/nemotron-3.5-super-vl:free
LLM_MODEL_B=google/gemma-4-31b-it:free
LLM_JUDGE_MODEL=inclusionai/ling-3.2-flash:free
# Repli ordonné (modèles :free uniquement, familles distinctes), essayé si le modèle principal est limité (429) ou indisponible (5xx, 400).
# Chaque candidat est revérifié à chaque appel (suffixe :free, prix 0 dans le catalogue OpenRouter) ; jamais de routage automatique OpenRouter.
LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free,baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free,inclusionai/ling-3.2-flash:free
